#!/bin/bash
{% if scheduler == "slurm" %}
#SBATCH --job-name={{ job_name }}
#SBATCH --nodes={{ nodes }}
#SBATCH --ntasks=1
#SBATCH --cpus-per-task={{ cpus }}
#SBATCH --time={{ walltime }}
{% if partition %}#SBATCH --partition={{ partition }}
{% endif %}
{% if account %}#SBATCH --account={{ account }}
{% endif %}
#SBATCH --output={{ job_name }}-%j.out
{% elif scheduler == "pbs" %}
#PBS -N {{ job_name }}
#PBS -l select={{ nodes }}:ncpus={{ cpus }}
#PBS -l walltime={{ walltime }}
{% if partition %}#PBS -q {{ partition }}
{% endif %}
{% if account %}#PBS -A {{ account }}
{% endif %}
#PBS -j oe
{% elif scheduler == "lsf" %}
#BSUB -J {{ job_name }}
#BSUB -nnodes {{ nodes }}
#BSUB -W {{ walltime_lsf }}
{% if partition %}#BSUB -q {{ partition }}
{% endif %}
{% if account %}#BSUB -P {{ account }}
{% endif %}
#BSUB -o {{ job_name }}-%J.out
{% endif %}
# Generated by spack-ai. Review before submitting.
set -euo pipefail

{% if modules %}
# Site modules
module purge || true
{% for module in modules %}
module load {{ module }}
{% endfor %}

{% endif %}
export SPACK_ROOT="${SPACK_ROOT:-{{ spack_root }}}"
# shellcheck disable=SC1091
source "${SPACK_ROOT}/share/spack/setup-env.sh"

ENV_DIR="{{ env_dir }}"
spack env activate -d "${ENV_DIR}"
{% for line in setup %}
{{ line }}
{% endfor %}

spack concretize --force
spack install --jobs {{ cpus }} --fail-fast{% if run_tests %} --test=root{% endif %}

spack env deactivate
echo "Build finished. Load it with: spack env activate -d ${ENV_DIR}"
